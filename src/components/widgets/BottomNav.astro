---
import { Icon } from 'astro-icon/components';

const navItems = [
  { name: 'หน้าแรก', href: '/', icon: 'tabler:home' },
  { name: 'เกี่ยวกับ', href: '/about', icon: 'tabler:user' },
  { name: 'Lab', href: '/lab', icon: 'tabler:flask' },
  { name: 'แหล่งข้อมูล', href: '/resources', icon: 'tabler:book' },
  { name: 'บทความ', href: '/posts', icon: 'tabler:article' },
];

const currentPath = Astro.url.pathname;
---

<nav
  class="fixed bottom-0 left-0 right-0 bg-pearl dark:bg-onyx border-t border-marble dark:border-velvet z-50 shadow-lg"
>
  <div class="max-w-7xl mx-auto px-4">
    <ul class="flex justify-around items-center py-2">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || currentPath.startsWith(item.href + '/');
          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'flex flex-col items-center gap-1 px-3 py-1 rounded-lg transition-colors',
                  isActive
                    ? 'text-accent dark:text-accent font-bold'
                    : 'text-silk/60 dark:text-silk/60 hover:text-accent dark:hover:text-accent',
                ]}
              >
                <Icon name={item.icon} class="w-6 h-6" />
                <span class="text-xs font-medium">{item.name}</span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>
