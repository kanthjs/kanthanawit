---
// import '@fontsource-variable/inter';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist

// Please check https://fontsource.org/
import '@fontsource-variable/noto-sans-thai';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Tight', 'Noto Sans Thai Variable', sans-serif;
    --aw-font-serif: 'Noto Sans Thai Variable', serif;
    --aw-font-heading: 'Inter Tight', 'Noto Sans Thai Variable', sans-serif;

    /* Dark Theme (Primary) */
    --color-bg: #19181a;
    --color-text: #e8e4d0;
    --color-primary: #479761;
    --color-accent: #479761;
    --color-button-secondary: #2a2725;

    /* AstroWind Mappings */
    --aw-color-primary: var(--color-primary);
    --aw-color-secondary: var(--color-button-secondary);
    --aw-color-accent: var(--color-accent);

    --aw-color-text-heading: #cebc81;
    --aw-color-text-default: var(--color-text);
    --aw-color-text-muted: #998877;
    --aw-color-bg-page: var(--color-bg);

    --aw-color-bg-page-dark: #19181a;

    /* ThaiUI Aliases */
    --color-onyx: #19181a;
    --color-velvet: #2a2725;
    --color-silk: #cebc81;
    --color-marble: #998877;
    --color-pearl: #cebc81;
    --color-champagne: #479761;

    /* Typography */
    --font-size-h1: 170px;
    --font-size-body: 14px;

    ::selection {
      background-color: #479761;
      color: #19181a;
    }
  }

  .dark {
    --color-bg: #19181a;
    --color-text: #e8e4d0;

    --aw-color-primary: #479761;
    --aw-color-secondary: #333333;
    --aw-color-accent: #479761;

    --aw-color-text-heading: #cebc81;
    --aw-color-text-default: #e8e4d0;
    --aw-color-text-muted: #998877;
    --aw-color-bg-page: var(--color-bg);

    /* Dark Theme Colors (Easy on Eyes) */
    --color-onyx: #19181a;
    --color-velvet: #2a2725;
    --color-champagne: #479761;
    --color-silk: #cebc81;
    --color-marble: #998877;
    --color-pearl: #cebc81;

    ::selection {
      background-color: #479761;
      color: #19181a;
    }
  }
</style>
