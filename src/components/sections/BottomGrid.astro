---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

// ดึงข้อเขียน (writing) เรียงตามวันล่าสุด (ใหม่ไปเก่า) และเอาอันแรกมาแสดง
const allWritings = await getCollection('writing');
allWritings.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestPost = allWritings[0];

// ดึงข้อมูล App โดยเจาะจงที่ rice-pest-risk-map หรือแสดงอันแรกสุดที่มี
const allApps = await getCollection('myapp');
const featuredApp = allApps.find(app => app.slug === 'rice-pest-risk-map') || allApps[0];
---

<div class="lg:col-span-12 grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">

  <!-- Personal Image Card -->
  <div class="rounded-3xl overflow-hidden h-[300px] relative">
    <Image
      src="https://live.staticflickr.com/65535/55133833635_b60ceb26b2.jpg"
      alt="Personal photo"
      width={600}
      height={800}
      class="w-full h-full object-cover"
      referrerpolicy="no-referrer"
    />
  </div>

  <!-- Card: Featured App (Dynamic) -->
  <a href={`/apps/${featuredApp?.slug || ''}`} class="md:col-span-1 bg-gray-50 dark:bg-gray-900 rounded-3xl p-6 border border-gray-100 dark:border-gray-800 flex flex-col group h-[300px]">
    <div class="flex justify-between items-center mb-4">
      <span class="text-[0.85rem] text-gray-400 dark:text-gray-500 font-normal"> Projects · งาน</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 dark:text-gray-500 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </div>
    <div class="flex-grow flex items-center justify-center bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 mt-2 p-4 overflow-hidden relative">
      <img
        src={featuredApp?.data.image || "/images/pest_risk_map.jpg"}
        alt={featuredApp?.data.title || "Featured Project"}
        class="w-full h-full object-cover rounded-xl group-hover:scale-[1.03] transition-transform duration-500"
        loading="lazy"
      />
    </div>
  </a>

  <!-- Card: Latest Blog Writing (Dynamic) -->
  <a href={`/writing/${latestPost?.slug || ''}`} class="bg-gray-50 dark:bg-gray-900 rounded-3xl p-6 border border-gray-100 dark:border-gray-800 flex flex-col group h-[300px]">
    <div class="flex justify-between items-center mb-4">
      <span class="text-[0.85rem] text-gray-400 dark:text-gray-500 font-normal">Writing Blog · ล่าสุด</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 dark:text-gray-500 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </div>
    <div class="mt-4 flex flex-col justify-center flex-grow">
      <h3 class="font-serif text-3xl leading-tight text-gray-800 dark:text-gray-200 group-hover:text-gray-600 dark:group-hover:text-gray-400 transition-colors line-clamp-3">
        {latestPost?.data.title || "ยังไม่มีบทความ"}
      </h3>
      {latestPost && (
        <p class="mt-4 text-sm text-gray-400 dark:text-gray-500 font-medium">
          {new Date(latestPost.data.pubDate).toLocaleDateString('th-TH', { 
            year: 'numeric', month: 'short', day: 'numeric' 
          })}
        </p>
      )}
    </div>
  </a>

</div>
