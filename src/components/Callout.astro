---
interface Props {
  title?: string;
  type?: 'info' | 'warning' | 'tip' | 'danger';
  collapsible?: string;
}

const { title, type = 'info' } = Astro.props;

const styles = {
  info:    { border: 'border-blue-200  dark:border-blue-800',  bg: 'bg-blue-50  dark:bg-blue-950/50',   icon: 'text-blue-500',   label: 'bg-blue-100  text-blue-700  dark:bg-blue-900  dark:text-blue-300' },
  warning: { border: 'border-amber-200 dark:border-amber-800', bg: 'bg-amber-50 dark:bg-amber-950/50',  icon: 'text-amber-500',  label: 'bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300' },
  tip:     { border: 'border-green-200 dark:border-green-800', bg: 'bg-green-50 dark:bg-green-950/50',  icon: 'text-green-500',  label: 'bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300' },
  danger:  { border: 'border-red-200   dark:border-red-800',   bg: 'bg-red-50   dark:bg-red-950/50',    icon: 'text-red-500',    label: 'bg-red-100   text-red-700   dark:bg-red-900   dark:text-red-300' },
};

const s = styles[type];
---

<div class={`my-6 rounded-xl border ${s.border} ${s.bg} p-4`}>
  {title && (
    <div class="flex items-center gap-2 mb-2">
      <span class={`text-[10px] font-semibold uppercase tracking-widest px-2 py-0.5 rounded-full ${s.label}`}>
        {type}
      </span>
      <span class="font-serif text-sm font-medium text-gray-800 dark:text-gray-200">{title}</span>
    </div>
  )}
  <div class="text-sm text-gray-600 dark:text-gray-400 font-body-serif leading-relaxed [&>p]:m-0">
    <slot />
  </div>
</div>
