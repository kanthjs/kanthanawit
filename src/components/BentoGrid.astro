---
---

<div class="lg:col-span-6 grid grid-cols-1 md:grid-cols-2 gap-6">
  <!-- Large Card: Design Spells -->
  <a href="https://star-th-scxrr8n7dntstyaeiqpgdy.streamlit.app/" class="md:col-span-2 bg-gray-50 dark:bg-gray-900 rounded-3xl p-6 border border-gray-100 dark:border-gray-800 flex flex-col group overflow-hidden h-[450px]">
    <div class="flex justify-between items-center mb-4">
      <span class="text-[0.85rem] text-gray-400 dark:text-gray-500 font-normal">Projects · Rice Pest Minitoring Network</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 dark:text-gray-500 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors">
        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
      </svg>
    </div>
    <div class="flex-grow flex items-center justify-center overflow-hidden">
      <img
        src="/images/pest-monitoring-network.jpg"
        alt="Rice Pest Monitoring Network TH"
        loading="eager"
        fetchpriority="high"
        class="rounded-xl shadow-2xl group-hover:scale-[1.02] transition-transform duration-500 w-[90%] border border-gray-200 dark:border-gray-700"
      />
    </div>
  </a>

  <!-- Medium Card: STAR-like -->
  <div class="bg-gray-50 dark:bg-gray-900 rounded-3xl p-6 border border-gray-100 dark:border-gray-800 flex flex-col group cursor-pointer overflow-hidden h-[400px]">
    <div class="flex justify-between items-center mb-4">
      <span class="text-[0.85rem] text-gray-400 dark:text-gray-500 font-normal">Projects · STAR-like APP</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-400 dark:text-gray-500 group-hover:text-gray-900 dark:group-hover:text-gray-100 transition-colors">
        <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
      </svg>
    </div>
    <div class="flex-grow relative mt-4">
      <img
        src="/images/STAR-like-app.jpg"
        alt="STAR-like App"
        class="absolute left-1/2 -translate-x-1/2 top-4 w-4/5 rounded-[2rem] shadow-lg border-4 border-white dark:border-gray-900"
      />
    </div>
  </div>

  <!-- Image Card: Hoppies  -->
  <div class="rounded-3xl overflow-hidden h-[400px] relative group cursor-pointer">
    <img
      src="https://live.staticflickr.com/65535/55133636443_8552fb4d92.jpg"
      alt="Trail at Krabi 2024"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
    />
    <div class="absolute bottom-4 left-4 bg-black/20 backdrop-blur-md px-3 py-1 rounded-full text-[10px] text-white font-medium">
      2024.03.04 @ Krabi, Thailand
    </div>
  </div>
</div>
