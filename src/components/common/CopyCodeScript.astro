<script is:inline>
  function addCopyButtons() {
    const codeBlocks = document.querySelectorAll('pre');

    codeBlocks.forEach((codeBlock) => {
      // Avoid duplicate buttons
      if (codeBlock.closest('.copy-code-wrapper')) return;

      const wrapper = document.createElement('div');
      wrapper.className = 'copy-code-wrapper relative group';

      const copyButton = document.createElement('button');
      copyButton.className =
        'copy-code-button absolute right-2 top-2 p-1.5 rounded-md bg-neutral-800/80 text-marble opacity-0 group-hover:opacity-100 transition-all duration-200 hover:bg-neutral-700 hover:text-silk focus:opacity-100 z-10 border border-white/10 flex items-center gap-1.5';
      copyButton.setAttribute('aria-label', 'Copy code');

      const iconCopy = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" /><path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.412 .412 1.737 1.012" /></svg>`;
      const iconCheck = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M5 12l5 5l10 -10" /></svg>`;

      copyButton.innerHTML = iconCopy;

      // Add "Copy" text on hover if screen is wide enough? Maybe just the icon is cleaner.
      // Let's stick to icon + feedback.

      codeBlock.parentNode.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);
      wrapper.appendChild(copyButton);

      copyButton.addEventListener('click', async () => {
        const codeElement = codeBlock.querySelector('code');
        const text = codeElement ? codeElement.innerText : codeBlock.innerText;

        try {
          await navigator.clipboard.writeText(text);

          copyButton.innerHTML = iconCheck + '<span class="text-xs font-medium">Copied!</span>';
          copyButton.classList.add('text-green-400', 'opacity-100');

          setTimeout(() => {
            copyButton.innerHTML = iconCopy;
            copyButton.classList.remove('text-green-400', 'opacity-100');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    });
  }

  // Initial run
  addCopyButtons();

  // Run on page transition
  document.addEventListener('astro:after-swap', addCopyButtons);
</script>

<style is:global>
  .copy-code-wrapper pre {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }
  .copy-code-wrapper {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }
</style>
