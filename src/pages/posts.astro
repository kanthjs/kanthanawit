---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { getStaticPathsBlogList, getBlogPermalink } from '~/utils/blog';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';

export const prerender = true;

const metadata = {
  title: 'Posts - กันต์ธณวิชญ์ ใจสงฆ์',
};

const posts = await getStaticPathsBlogList({ paginate: undefined });
const recentPosts = posts.slice(0, 6);
---

<PersonalLayout metadata={metadata}>
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white dark:bg-gray-900 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <Headline
        subtitle="Sharing my thoughts, research findings, tutorials, and other interesting content."
      >
        Posts
      </Headline>
      
      <div class="text-center mb-8">
        <a 
          href={getBlogPermalink()}
          class="inline-flex items-center px-6 py-3 bg-green-600 text-white font-medium rounded-lg hover:bg-green-700 transition-colors"
        >
          View All Posts
        </a>
      </div>
      
      <div class="grid gap-6">
        <p class="text-gray-600 dark:text-gray-300 text-center">
          Recent posts will appear here. Click "View All Posts" to see the complete blog.
        </p>
      </div>
    </div>
  </section>
</PersonalLayout>
