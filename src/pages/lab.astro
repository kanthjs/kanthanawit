---
import PersonalLayout from '~/layouts/PersonalLayout.astro';

const metadata = {
  title: 'Lab - กันต์ธณวิชญ์ ใจสงฆ์',
};
---

<PersonalLayout metadata={metadata}>
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white dark:bg-gray-900 min-h-screen">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-8">Lab</h1>
      
      <div class="prose dark:prose-invert max-w-none">
        <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed mb-6">
          Welcome to my lab page. Here you will find information about my research projects,
          experiments, and laboratory work.
        </p>
        
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-8 mb-4">Current Projects</h2>
        <div class="grid gap-6 md:grid-cols-2">
          <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Project 1</h3>
            <p class="text-gray-600 dark:text-gray-300">Description of your first research project...</p>
          </div>
          <div class="p-6 bg-gray-50 dark:bg-gray-800 rounded-lg">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Project 2</h3>
            <p class="text-gray-600 dark:text-gray-300">Description of your second research project...</p>
          </div>
        </div>
        
        <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mt-8 mb-4">Publications</h2>
        <ul class="list-disc pl-6 text-gray-600 dark:text-gray-300">
          <li>Publication 1 (Year)</li>
          <li>Publication 2 (Year)</li>
        </ul>
      </div>
    </div>
  </section>
</PersonalLayout>
