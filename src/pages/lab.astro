---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Lab - กันต์ธณวิชญ์ ใจสงฆ์',
};

interface ResearchItem {
  title: string;
  description: string;
  icon?: string;
  image?: string;
  link?: string;
}

const researches: ResearchItem[] = [
  {
    title: 'การพยากรณ์การระบาดของศัตรูข้าว',
    description:
      'การศึกษาติดตามการเปลี่ยนแปลงสถานการณ์การระบาดของศัตรูข้าวในแปลงนาเกษตรกร ครอบคลุมระบบนิเวศน์หลากหลายรูปแบบ เพื่อทำความเข้าใจพลวัตการระบาดของศัตรูข้าวที่เกิดขึ้นภายใต้สภาพแวดล้อมและการจัดการนาที่แตกต่างกัน อันจะนำไปสู่การสร้างฐานข้อมูลสำหรับวางแผนเฝ้าระวังและเตือนภัยการระบาดในอนาคต',
    icon: 'tabler:chart-line',
  },
  {
    title: 'การพัฒนาแบบจำลองความเสียหายของโรคข้าว',
    description:
      'การประเมินความเสียหายของผลผลิตข้าวที่เกิดจากการทำลายของโรคข้าวที่สำคัญ ได้แก่ โรคไหม้ (rice blast) โรคใบจุดสีน้ำตาล (brown spot) และโรคขอบใบแห้ง (bacterial leaf blight) โดยมุ่งเน้นการประเมินเชิงปริมาณเพื่อให้ได้ข้อมูลที่สะท้อนผลกระทบที่แท้จริงของโรคเหล่านี้ต่อผลผลิตข้าว ซึ่งจะเป็นประโยชน์ต่อการกำหนดแนวทางการป้องกันและลดความสูญเสียทางเศรษฐกิจของเกษตรกร',
    icon: 'tabler:leaf',
  },
  {
    title: 'APP เพื่อการวิเคราะห์ข้อมูลการทดลองทางการเกษตร (STAR-like APP)',
    description:
      'จากประสบการณ์ พบว่า โปรแกรมสถิติที่ใช้อยู่นั้น บางอย่าง มีลิขสิทธิ์ที่ มีราคา แต่เนื่องจาก ปัจจุบัน มีการพใช้ ภาษา R หรือ python เข้ามาวิเคราะห์ แล้วภาษาเหล่านี้ ก็ ไปไกลมากกว่า วิเคราะห์สถิติแล้ว และก็สามารถพัฒนา app ด้วยปภาษาของตัวเองกัน จึงมีความคิดที่จะ สรา้งมาเป็น app เพื่อใช้ในการวิเคราะห์ข้อมูลการทดลองทางการเกษตร แบบออนไลน์',
    icon: 'tabler:app-window',
    link: 'https://star-th-scxrr8n7dntstyaeiqpgdy.streamlit.app/',
  },
];
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-page min-h-screen">
    <div class="max-w-4xl mx-auto">
      <div>
        <h2 class="text-2xl font-bold text-silk mb-8 pb-2 border-b border-gray-300">การวิจัย</h2>

        <div class="grid grid-cols-1 gap-6">
          {
            researches.map((research) => {
              const Element = research.link ? 'a' : 'div';
              return (
                <Element
                  href={research.link}
                  class="flex flex-col sm:flex-row items-center gap-6 p-4 rounded-xl hover:bg-velvet/50 transition-all group border border-transparent hover:border-champagne/20 shadow-sm hover:shadow-md bg-page"
                >
                  <div class="w-full sm:w-48 h-32 flex-shrink-0 bg-velvet rounded-lg overflow-hidden border border-champagne/30 group-hover:border-champagne/60 transition-colors">
                    {research.image ? (
                      <img
                        src={research.image}
                        alt={research.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-velvet to-black">
                        <Icon
                          name={research.icon || 'tabler:microscope'}
                          class="w-12 h-12 text-accent group-hover:scale-110 transition-transform duration-500"
                        />
                      </div>
                    )}
                  </div>
                  <div class="flex-1 min-w-0 text-center sm:text-left">
                    <h3 class="text-xl font-bold text-silk group-hover:text-accent transition-colors flex items-center justify-center sm:justify-start gap-2">
                      {research.title}
                      {research.link && (
                        <Icon
                          name="tabler:external-link"
                          class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                        />
                      )}
                    </h3>
                    <p class="text-default mt-2 leading-relaxed">{research.description}</p>
                    {research.link && (
                      <div class="mt-4 flex items-center justify-center sm:justify-start">
                        <span class="text-xs font-medium px-2.5 py-0.5 rounded bg-accent/10 text-accent border border-accent/20 group-hover:bg-accent group-hover:text-white transition-colors">
                          View Details
                        </span>
                      </div>
                    )}
                  </div>
                </Element>
              );
            })
          }
        </div>
      </div>
    </div>
  </section>
</PersonalLayout>
