---
import PersonalLayout from '~/layouts/PersonalLayout.astro';

const metadata = {
  title: 'Lab - กันต์ธณวิชญ์ ใจสงฆ์',
};
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-page min-h-screen">
    <div class="max-w-4xl mx-auto">
      <!-- Our Research -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">การวิจัย</h2>

        <div class="space-y-6 text-default leading-relaxed">
          <p>ตอนนี้มีผมอยู่คนเดียว 555</p>

          <p>
            งาน <strong class="text-silk">modeling work</strong> เป็นงานที่ผมสนใจ
          </p>
        </div>
      </div>
    </div>
  </section>
</PersonalLayout>
