---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { getPermalink } from '~/utils/permalinks';
import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Posts${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};

// ฟอร์แมตวันที่เป็น MM-DD-YYYY
const formatDate = (date: Date) => {
  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');
  const year = date.getFullYear();
  return `${month}-${day}-${year}`;
};
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-neutral-900 min-h-screen">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-8 pb-4 border-b border-gray-600">
        <h1 class="text-2xl font-bold text-white">Posts</h1>
        <p class="text-gray-400 mt-2">บทความและเรื่องราวต่างๆ</p>
      </div>

      <!-- Posts List -->
      <div class="space-y-4">
        {page.data.map((post) => (
          <a 
            href={getPermalink(post.permalink, 'post')}
            class="flex items-start gap-4 p-3 -mx-3 rounded-lg hover:bg-white/5 transition-colors group"
          >
            <!-- Thumbnail -->
            <div class="w-16 h-16 flex-shrink-0 bg-gray-800 rounded overflow-hidden">
              {post.image ? (
                <img 
                  src={post.image} 
                  alt={post.title}
                  class="w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center bg-gray-800">
                  <span class="text-gray-600 text-xs">IMG</span>
                </div>
              )}
            </div>
            
            <!-- Content -->
            <div class="flex-1 min-w-0 py-1">
              <h2 class="text-base font-semibold text-white underline decoration-gray-600 group-hover:decoration-gray-400 transition-colors leading-snug">
                {post.title}
              </h2>
              <p class="text-sm text-gray-400 mt-1.5">
                {formatDate(post.publishDate)}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Pagination -->
      {(page.url.prev || page.url.next) && (
        <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-700">
          {page.url.prev ? (
            <a 
              href={page.url.prev}
              class="text-gray-400 hover:text-white transition-colors text-sm"
            >
              ← Previous
            </a>
          ) : (
            <span />
          )}
          
          <span class="text-gray-500 text-sm">
            Page {page.currentPage} of {page.lastPage}
          </span>
          
          {page.url.next ? (
            <a 
              href={page.url.next}
              class="text-gray-400 hover:text-white transition-colors text-sm"
            >
              Next →
            </a>
          ) : (
            <span />
          )}
        </div>
      )}
    </div>
  </section>
</PersonalLayout>
