---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { statusColor } from '../utils/bookStatus';

const books = await getCollection('books');
---

<Layout title="Kanth's Playbook | Reading">
  <Header />
  <main class="max-w-7xl mx-auto px-6 py-12">
    <h1 class="font-serif text-5xl md:text-6xl lg:text-7xl text-gray-900 mb-6">อ่าน-ing</h1>
    <p class="text-gray-500 text-lg font-body-serif max-w-2xl mb-16 leading-relaxed">
      หนังสือผมกำลังอ่าน และอยากแนะนำให้อ่าน ถ้าอยากรู้ก็ คลิ้กอ่าน ที่สรุปย่อ ๆ ดูนะ
    </p>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
      {books.map((book) => (
        <a
          href={`/reading/${book.slug}`}
          class="group flex flex-col gap-3"
        >
          <div class="relative overflow-hidden rounded-xl aspect-[2/3] bg-gray-50 border border-gray-100 shadow-sm group-hover:shadow-md transition-shadow duration-300">
            <img
              src={book.data.image}
              alt={book.data.title}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              referrerpolicy="no-referrer"
            />
            <div class="absolute top-2 left-2">
              <span class={`text-[10px] font-semibold tracking-wider px-2 py-1 rounded-full ${statusColor[book.data.status]}`}>
                {book.data.status}
              </span>
            </div>
          </div>
          <div class="space-y-0.5">
            <span class="text-xs font-medium uppercase tracking-wider text-gray-400">Reading · Books</span>
            <h2 class="font-serif text-sm text-gray-900 leading-snug group-hover:underline decoration-gray-300 underline-offset-2 decoration-1 line-clamp-2">
              {book.data.title}
            </h2>
            <p class="text-xs text-gray-400 font-body-serif">{book.data.author}</p>
          </div>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
