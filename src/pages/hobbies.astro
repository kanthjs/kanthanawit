---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Category = 'plants' | 'hobbies' | 'work-gear' | 'personal-gear';

const categoryLabels: Record<Category, string> = {
  plants: 'Plants',
  hobbies: 'Hobbies',
  'work-gear': 'Work Gear',
  'personal-gear': 'Personal Gear',
};

const allItems = await getCollection('hobbies');
const categories = Object.keys(categoryLabels) as Category[];
---

<Layout title="Kanth's Playbook | Hobbies">
  <Header />
  <main class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="font-sans text-5xl md:text-6xl lg:text-7xl text-gray-900 dark:text-gray-100 mb-16">ที่ชอบที่ชอบ</h1>

    {categories.map((cat) => {
      const catItems = allItems.filter((i) => i.data.category === cat);
      if (catItems.length === 0) return null;
      return (
        <section class="mb-16">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6">{categoryLabels[cat]}</h2>
          <div class="columns-2 sm:columns-3 md:columns-4 lg:columns-5 gap-4">
            {catItems.map((item) => (
              <a href={`/hobbies/${item.slug}`} class="break-inside-avoid mb-4 block group">
                <div class="bg-gray-50 dark:bg-gray-900 border border-gray-100 dark:border-gray-800 rounded-2xl p-4 flex flex-col gap-2">
                  {item.data.image && (
                    <div class="overflow-hidden rounded-xl aspect-square mb-2">
                      <img
                        src={item.data.image}
                        alt={item.data.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <div class="flex items-start justify-between gap-2">
                    <span class="text-[10px] font-medium uppercase tracking-wider text-gray-400 dark:text-gray-500">{categoryLabels[item.data.category]}</span>
                    {item.data.affiliate && (
                      <span class="shrink-0 text-[9px] font-semibold uppercase tracking-wider bg-amber-100 text-amber-600 px-1.5 py-0.5 rounded-full">Affiliate</span>
                    )}
                  </div>
                  {item.data.tags && item.data.tags.map((tag) => (
                    <span class="text-[10px] font-semibold tracking-widest text-amber-500">{tag}</span>
                  ))}
                  <h3 class="font-sans text-base text-gray-900 dark:text-gray-100 leading-snug group-hover:underline decoration-gray-300 dark:decoration-gray-600 underline-offset-2 decoration-1">{item.data.title}</h3>
                  {item.data.subtitle && (
                    <p class="text-xs text-gray-400 dark:text-gray-500 leading-snug">{item.data.subtitle}</p>
                  )}
                  {item.data.description && (
                    <p class="text-xs text-gray-500 dark:text-gray-400 italic mt-1">{item.data.description}</p>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}
  </main>
  <Footer />
</Layout>
