---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'กันต์ธณวิชญ์ ใจสงฆ์ - Personal Website',
  ignoreTitleTemplate: true,
};

const socialLinks = [
  { name: 'GitHub', icon: 'tabler:brand-github', href: 'https://github.com' },
  { name: 'LinkedIn', icon: 'tabler:brand-linkedin', href: 'https://linkedin.com' },
  { name: 'Email', icon: 'tabler:mail', href: 'mailto:email@example.com' },
  { name: 'Scholar', icon: 'tabler:school', href: '#' },
];
---

<PersonalLayout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative w-full h-screen min-h-[600px] overflow-hidden">
    <!-- Background Image with Dark Green Leaf Theme -->
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1614594975525-e45890e2e122?w=1920&q=80"
        alt="Dark green tropical leaf background"
        class="w-full h-full object-cover"
      />
      <!-- Darker overlay for dramatic effect and better text readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/60 to-black/30"></div>
    </div>

    <!-- Content positioned at bottom-left -->
    <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col items-start">
          <!-- Name -->
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold text-white mb-4 tracking-tight">
            กันต์ธณวิชณ์<br />
            <span class="text-4xl md:text-6xl lg:text-7xl">ใจสงฆ์</span>
          </h1>

          <!-- Position and University -->
          <div class="flex flex-col gap-2 mb-6">
            <p class="text-xl md:text-2xl text-white/90 font-medium">
              Graduate Student
            </p>
            <p class="text-lg md:text-xl text-white/80">
              Chiang Mai University
            </p>
          </div>

          <!-- Social Media Icons -->
          <div class="flex items-center gap-4">
            {
              socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white/80 hover:text-white transition-colors p-2 hover:bg-white/10 rounded-full"
                  aria-label={link.name}
                >
                  <Icon name={link.icon} class="w-7 h-7" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick Introduction Section -->
  <section class="py-16 px-4 sm:px-6 lg:px-8 bg-white dark:bg-gray-900">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-6">Welcome to My Personal Website</h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        This is my digital space where I share my research, lab work, useful resources, and thoughts.
        Feel free to explore and connect with me through the navigation below.
      </p>
    </div>
  </section>
</PersonalLayout>

