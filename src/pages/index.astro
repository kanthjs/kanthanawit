---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'กันต์ Website',
  ignoreTitleTemplate: true,
};

const socialLinks = [
  { name: 'GitHub', icon: 'tabler:brand-github', href: 'https://github.com' },
  { name: 'LinkedIn', icon: 'tabler:brand-linkedin', href: 'https://linkedin.com' },
  { name: 'Email', icon: 'tabler:mail', href: 'mailto:email@example.com' },
  { name: 'Scholar', icon: 'tabler:school', href: '#' },
];
---

<PersonalLayout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative w-full h-screen min-h-[600px] overflow-hidden">
    <!-- Background Image with Dark Green Leaf Theme -->
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1710262210837-bdda56e84a3a?q=80&w=2070&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
        alt="a-field-with-a-wooden-structure-in-the-middle-of-it"
        class="w-full h-full object-cover"
      />
      <!-- Darker overlay for dramatic effect and better text readability -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/60 to-black/30"></div>
    </div>

    <!-- Content positioned at bottom-left -->
    <div class="absolute bottom-0 left-0 right-0 p-8 md:p-16">
      <div class="max-w-7xl mx-auto">
        <div class="flex flex-col items-start">
          <!-- Name -->
          <h1 class="text-xl md:text-7xl lg:text-8xl font-bold text-white mb-4 tracking-tight uppercase">
            กันต์ธณวิชญ์ ใจสงฆ์
          </h1>

          <!-- Position and University -->
          <div class="flex flex-col gap-2 mb-6">
            <p class="text-xl md:text-2xl text-white/90 font-medium">นักวิชาการเกษตร</p>
            <p class="text-lg md:text-xl text-white/80">กรมการข้าว</p>
          </div>

          <!-- Social Media Icons -->
          <div class="flex items-center gap-4">
            {
              socialLinks.map((link) => (
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-silk/80 hover:text-silk transition-colors p-2 hover:bg-pearl/10 rounded-full"
                  aria-label={link.name}
                >
                  <Icon name={link.icon} class="w-7 h-7" />
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</PersonalLayout>
