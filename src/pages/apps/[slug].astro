---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Callout from '../../components/ui/Callout.astro';

// Builder routes from 'myapp' collection
export async function getStaticPaths() {
  const apps = await getCollection('myapp');
  return apps.map((app) => ({
    params: { slug: app.slug },
  }));
}

const { slug } = Astro.params;
const app = await getEntry('myapp', slug);

// Redirect back home if app slug isn't found
if (!app) return Astro.redirect('/apps');

// Load MDX content
const { Content } = await app.render();
---

<Layout title={`Kanth's Playbook | ${app.data.title}`} description={app.data.excerpt} image={app.data.image}>
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-12">
    <!-- Back button -->
    <a href="/apps" class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Apps
    </a>

    <!-- Detail Header -->
    <header class="mb-12">
      {app.data.image && (
        <img 
          src={app.data.image} 
          alt={`${app.data.title} cover`} 
          class="w-full h-auto aspect-[16/9] object-cover rounded-3xl mb-8 border border-gray-100 dark:border-gray-800"
        />
      )}
      <div class="flex flex-col gap-4">
        <h1 class="font-sans text-4xl md:text-5xl text-gray-900 dark:text-gray-100 leading-tight">
          {app.data.title}
        </h1>
        {app.data.excerpt && (
          <p class="text-lg text-gray-600 dark:text-gray-400 font-body-serif leading-relaxed">
            {app.data.excerpt}
          </p>
        )}
        {app.data.url && (
            <div class="mt-4">
              <!-- External Link Button Form -->
              <a href={app.data.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 hover:bg-gray-800 dark:hover:bg-gray-200 transition-colors rounded-xl text-sm font-medium w-full sm:w-auto">
                ไปยัง App
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              </a>
            </div>
        )}
      </div>
    </header>

    <!-- App Body Content -->
    <div class="prose prose-gray dark:prose-invert prose-base max-w-none font-body-serif leading-relaxed prose-headings:font-sans prose-headings:text-gray-900 dark:prose-headings:text-gray-100 prose-a:text-gray-700 dark:prose-a:text-gray-300 prose-a:underline-offset-4 prose-p:text-gray-600 dark:prose-p:text-gray-400 prose-img:rounded-2xl">
      <Content components={{ Callout }} />
    </div>

  </main>

  <Footer />
</Layout>
