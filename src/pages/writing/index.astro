---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';

// ดึงบทความและจัดเรียงจากใหม่ไปเก่า
const allPosts = await getCollection('writing');
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Kanth's Playbook | Writing">
  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12">
    <!-- Page Header -->
    <header class="mb-10">
      <h1 class="text-2xl md:text-3xl font-sans font-bold text-gray-800 dark:text-gray-200 tracking-tight flex items-center gap-2">
        ขีด ๆ เขียน ๆ
      </h1>
    </header>

    <!-- Post List (Image-left layout) -->
    <div class="flex flex-col">
      {allPosts.map((post) => (
        <div class="border-b border-gray-100 dark:border-gray-800 last:border-0 py-8 first:pt-0">
          <a 
            href={`/writing/${post.slug}`} 
            class="group flex flex-col sm:flex-row gap-6 items-start"
          >
            <!-- Thumbnail Box -->
            <div class="w-full sm:w-56 h-36 shrink-0 bg-[#f1f2f4] dark:bg-gray-800 rounded-xl flex items-center justify-center text-gray-900 dark:text-gray-100 group-hover:bg-[#e6e8eb] dark:group-hover:bg-gray-700 transition-colors overflow-hidden">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover" loading="lazy" />
              ) : (
                <!-- Astro Logo SVG (as seen in the reference) -->
                <svg class="w-12 h-12" viewBox="0 0 256 366" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid">
                  <path fill="currentColor" d="M213.922 288.751c-8.91 0-16.141 6.556-16.141 14.65v2.871l-15.652-32.96c-5.495-12.062-17.553-19.648-31.134-19.141h-.103c-23.774.898-46.721 10.375-68.51 28.239l-22.115-46.205C90.358 178.67 110.151 103.543 128 35c24.086 92.49 46.16 176.711 77.012 240.245l11.026 23.33v-9.824c0-8.094 7.23-14.65 16.14-14.65 8.91 0 16.142 6.556 16.142 14.653v31.428l7.669 16.161C238.115 304.582 231.294 288.75 213.922 288.75v.001zM118.068 280.932c18.57-19.789 40.54-30.824 64.912-32.551 6.526-.462 8.448 3.513 10.957 8.784l23.102 48.647h-11.455v15.016l-3.351.46c-17.768 2.45-31.22 17.072-31.22 35.158v9.423a238.381 238.381 0 0 1-35.302-31.066l18.318-20.945c4.787-5.494 4.205-13.811-1.302-18.614-5.506-4.801-13.864-4.22-18.653 1.272l-18.916 21.657a242.023 242.023 0 0 1-62.77-96l45.68 98.759z"/>
                </svg>
              )}
            </div>

            <!-- Content Area -->
            <div class="flex-grow pt-1">
              <div class="flex flex-wrap items-center gap-3 mb-2">
                <h3 class="font-sans text-lg md:text-xl font-bold text-gray-800 dark:text-gray-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {post.data.title}
                </h3>
                
                {/* Badge */}
                {post.data.tags && post.data.tags.length > 0 && (
                  <span class="px-2.5 py-0.5 bg-blue-500 text-white text-[10px] uppercase font-bold tracking-wide rounded-full">
                    {post.data.tags[0]}
                  </span>
                )}
              </div>
              
              <p class="text-sm text-gray-600 dark:text-gray-400 font-body-serif leading-relaxed line-clamp-2 md:line-clamp-3">
                {post.data.excerpt}
              </p>
            </div>

          </a>
        </div>
      ))}
    </div>
  </main>

  <Footer />
</Layout>
