---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Callout from '../../components/Callout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('writing');
  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getEntry('writing', slug);
if (!post) return Astro.redirect('/writing');

const { Content } = await post.render();
---

<Layout title={`Kanth's Playbook | ${post.data.title}`}>
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12">
    <a href="/writing" class="inline-flex items-center gap-2 text-xs uppercase tracking-widest text-gray-400 hover:text-gray-700 transition-colors mb-12">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Writing
    </a>

    <header class="mb-12">
      <div class="flex flex-wrap gap-2 mb-4">
        {post.data.tags?.map((tag) => (
          <span class="text-xs font-medium tracking-wider text-gray-400 uppercase">{tag}</span>
        ))}
      </div>
      <h1 class="font-serif text-3xl md:text-5xl text-gray-900 leading-tight mb-4">
        {post.data.title}
      </h1>
      <time class="text-sm text-gray-400 font-body-serif">
        {post.data.pubDate.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
    </header>

    <div class="prose prose-gray prose-base max-w-none font-body-serif leading-relaxed prose-headings:font-serif prose-headings:text-gray-900 prose-a:text-gray-700 prose-a:underline-offset-4 prose-p:text-gray-600">
      <Content components={{ Callout }} />
    </div>
  </main>
  <Footer />
</Layout>
