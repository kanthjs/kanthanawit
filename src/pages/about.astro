---
import PersonalLayout from '~/layouts/PersonalLayout.astro';

const metadata = {
  title: 'About - กันต์ธณวิชญ์ ใจสงฆ์',
};
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-page min-h-screen">
    <div class="max-w-4xl mx-auto">
      <!-- Main Top Image -->
      <div class="mb-12">
        <img
          src="/about_web.jpg"
          alt="About กันต์ธณวิชญ์"
          class="w-full h-auto rounded-3xl shadow-2xl object-cover max-h-[500px] grayscale contrast-125"
        />
      </div>

      <div class="space-y-16">
        <!-- Resumé Section -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">Resumé</h2>
          <div class="text-default leading-relaxed space-y-4">
            <p>
              กันต์ธณวิชญ์ เป็นนักวิชาการเกษตร ที่ทำงานที่ <strong class="text-silk">กรมการข้าว</strong>
            </p>
            <p>
              ปัจจุบันกำลังศึกษาในระดับ <strong class="text-silk">Graduate Student ที่ Chiang Mai University</strong> โดยมีความสนใจและเชี่ยวชาญในด้านการจัดการโรคพืชและเกษตรอัจฉริยะ
            </p>
            <p class="text-sm text-marble">
              Access to profiles: <a href="#" class="underline hover:text-silk transition-colors">ORCID</a>, <a
                href="#"
                class="underline hover:text-silk transition-colors">Google Scholar</a
              >, <a href="#" class="underline hover:text-silk transition-colors">ResearchGate</a>
            </p>
          </div>
        </section>

        <!-- Education/Services Section -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">การศึกษา / Education</h2>
          <div class="text-default leading-relaxed">
            <ul class="list-none space-y-2">
              <li>• <strong class="text-silk">Graduate Student</strong> - Chiang Mai University</li>
              <li>• <strong class="text-silk">Bachelor's Degree</strong> - [ชื่อมหาวิทยาลัยเดิม]</li>
            </ul>
          </div>
        </section>

        <!-- Research Interests Section -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">
            สาขาวิชาที่สนใจ / Research Interests
          </h2>
          <div class="text-default leading-relaxed">
            <p>ผมมีความสนใจในด้านวิทยาศาสตร์การเกษตรและการประยุกต์ใช้เทคโนโลยีเพื่อเพิ่มประสิทธิภาพการผลิต:</p>
            <ul class="list-none mt-4 space-y-2">
              <li class="hover:text-silk transition-colors">• โรคพืชวิทยา (Plant Pathology)</li>
              <li class="hover:text-silk transition-colors">• ระบบเตือนภัยล่วงหน้า (Warning Systems)</li>
              <li class="hover:text-silk transition-colors">• เกษตรแม่นยำ (Precision Agriculture)</li>
            </ul>
          </div>
        </section>

        <!-- Talks and videos -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">Talks and videos</h2>
          <p class="text-default">
            สามารถรับชมสไลด์การบรรยายและวิดีโอที่ผ่านมาได้ที่ <a
              href="#"
              class="underline hover:text-silk transition-colors">YouTube</a
            > และ <a href="#" class="underline hover:text-silk transition-colors">Speakerdeck</a>
          </p>
        </section>

        <!-- Portrait Section -->
        <section class="flex flex-col md:flex-row gap-8 items-start pt-8">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">Portrait</h2>
            <p class="text-default leading-relaxed">
              ภาพพอร์ตเทรตนี้สามารถนำไปใช้ในสื่อประชาสัมพันธ์ การบรรยาย หรืองานนำเสนอทางวิชาการได้ตามต้องการ
              คุณสามารถดาวน์โหลดภาพความละเอียดสูงเพื่อใช้ในการจัดทำโปรไฟล์ต้นสังกัดหรือเอกสารตีพิมพ์ต่างๆ
            </p>
          </div>
          <div class="w-32 h-32 md:w-40 md:h-40 flex-shrink-0 mt-8 md:mt-0">
            <div class="w-full h-full bg-gray-800 rounded-2xl overflow-hidden shadow-xl">
              <img
                src="/about_web.jpg"
                alt="Portrait"
                class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
              />
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</PersonalLayout>
