---
import PersonalLayout from '~/layouts/PersonalLayout.astro';

const metadata = {
  title: 'About - กันต์ธณวิชญ์',
};
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-page min-h-screen">
    <div class="max-w-4xl mx-auto">
      <!-- Main Top Image -->
      <div class="mb-12">
        <img
          src="/about_web.jpg"
          alt="About กันต์ธณวิชญ์"
          class="w-full h-auto rounded-3xl shadow-2xl object-cover max-h-[500px] grayscale contrast-125"
        />
      </div>

      <div class="space-y-16">
        <!-- Resumé Section -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">Resumé</h2>
          <div class="text-default leading-relaxed space-y-4">
            <p>
              รับราชการในตำแหน่งนักวิชาการเกษตรที่ทำงานที่ <strong class="text-silk"> ศูนย์วิจัยข้าวปทุมธานี</strong> รับผิดชอบ
              งานวิจัยด้านอารักขาข้าวเป็นหลักและหัวข้องานวิจัยด้านข้าวอื่น ๆ อีกที่เกี่ยวข้อง
            </p>
             <p>
              มีความรู้ความถนัด ด้านโรคพืช ด้านระบาดวิทยาโรคพืช <strong class="text-silk"> University of the Philippines Los Baños</strong> 
              ได้รับ ทุน Ph.D. scholarship จาก <strong class="text-silk"> IRRI- International Rice Research Institute </strong> 
            </p>
            
          </div>
        </section>

        <!-- Research Interests Section -->
        <section>
          <h2 class="text-xl font-bold text-silk mb-6 pb-2 border-b border-gray-300">
            ความสนใจ
          </h2>
          <div class="text-default leading-relaxed">
            <p> มีความสนใจและความเชี่ยวชาญด้าน <strong class="text-silk"> ระบาดวิทยาโรคพืช </strong> 
              โดยเฉพาะการประยุกต์ใช้ <strong class="text-silk">สถิติและแบบจำลองทางคณิตศาสตร์</strong> 
              เพื่ออธิบายพลวัตการระบาดของศัตรูพืชในสภาพแปลงจริง ทั้งนี้ ได้นำ <strong class="text-silk"> R Language </strong> และ <strong class="text-silk"> python </strong> 
              มาใช้เป็นเครื่องมือหลักในการวิเคราะห์ข้อมูลและพัฒนาแบบจำลอง ควบคู่ไปกับการศึกษาเรียนรู้ภาษา R และ Python เพิ่มเติม เพื่อขยายขีดความสามารถในการจัดการข้อมูลขนาดใหญ่และเชื่อมต่อกับ <strong class="text-silk"> Machine learning </strong> 
              นอกจากนี้ยังให้ความสำคัญกับการนำองค์ความรู้ทางระบาดวิทยามาบูรณาการกับการสร้าง <strong class="text-silk">predictive modeling</strong> 
              เพื่อพัฒนา <strong class="text-silk"> ระบบเตือนภัยการระบาดศัตรูพืช</strong> 
              ที่สามารถช่วยให้เกษตรกรและหน่วยงานที่เกี่ยวข้องเตรียมรับมือกับสถานการณ์การระบาดได้อย่างทันท่วงที</p>
          </div>
        </section>
      </div>
    </div>
  </section>
</PersonalLayout>