---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'Resources - กันต์ธณวิชญ์ ใจสงฆ์',
};

const books = [
  {
    title: 'เทคนิคการทดลองในแปลงนาข้าว',
    titleLink: 'https://kanthjs.github.io/tech_rice_exp_book/',
    description:
      'คือหนังสืออนไลน์ ที่จัดทำขึ้นเพื่อเป็นแนวทางปฏิบัติที่ดีที่สุดสำหรับนักวิจัยข้าวที่ทำการทดลองภาคสนาม ไม่ว่าจะเป็นการทดลองเพื่อประเมินพันธุ์ข้าวใหม่ การทดสอบปุ๋ย หรือการศึกษาปัจจัยแวดล้อมต่าง ๆ ที่มีผลต่อการเจริญเติบโตและผลผลิตของข้าว',
    image: 'https://kanthjs.github.io/tech_rice_exp_book/logo.png',
    imageAlt: 'เทคนิคการทดลองในแปลงนาข้าว',
  },
];

const apps = [
  {
    title: 'Rice Pest Risk Map App',
    description: 'shiny app แสดงแผนที่ความเสี่ยงจากศัตรูข้าว',
    icon: 'tabler:chart-bar',
    image: '/pest_risk_map.jpg',
    link: 'https://019c7053-50f5-df71-f17a-8aff60e3fe9f.share.connect.posit.cloud/',
  },
  {
    title: 'Rice Pest Warning App',
    description: 'shiny app แสดงข้อมูลการเตือนภัยศัตรูข้าว',
    icon: 'tabler:database',
    image: '/pest_warning_app.jpg',
    link: 'https://019c661b-3539-7d06-0829-41c5c53c7250.share.connect.posit.cloud/',
  },
];
---

<PersonalLayout metadata={metadata}>
  <section class="py-12 px-4 sm:px-6 lg:px-8 bg-page min-h-screen">
    <div class="max-w-4xl mx-auto">
      <!-- Books Section -->
      <div class="mb-16">
        <h2 class="text-2xl font-bold text-silk mb-8 pb-2 border-b border-gray-300">หนังสือ</h2>

        <div class="space-y-10">
          {
            books.map((book) => (
              <div class="flex gap-6 items-start">
                <div class="flex-1 text-default leading-relaxed">
                  <p>
                    <a
                      href={book.titleLink}
                      class="font-bold text-silk underline decoration-accent hover:decoration-accent transition-colors"
                    >
                      {book.title}
                    </a>
                    {book.year && <span class="text-default"> ({book.year})</span>} {book.description}
                    {book.links &&
                      book.links.map((link, idx) => (
                        <>
                          <a
                            href={link.url}
                            class="underline decoration-accent hover:decoration-accent transition-colors text-default"
                          >
                            {link.text}
                          </a>
                          {idx < book.links.length - 1 ? ', ' : ''}
                        </>
                      ))}
                    {book.boldParts && (
                      <>
                        {' '}
                        {book.descriptionEnd} I had the privilege to serve as one of the{' '}
                        <strong class="text-silk">{book.boldParts[0]}</strong> for this edition and I am the{' '}
                        <strong class="text-silk">{book.boldParts[1]}</strong> specifically focused on Plant Disease
                        Epidemiology, including epidemic modeling, disease progress analysis, and warning systems.
                      </>
                    )}
                  </p>
                </div>
                <div class="w-32 flex-shrink-0">
                  <div class="aspect-[3/4] bg-velvet rounded overflow-hidden">
                    {book.image ? (
                      <img src={book.image} alt={book.imageAlt} class="w-full h-full object-cover" />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center bg-velvet">
                        <Icon name="tabler:book" class="w-12 h-12 text-champagne" />
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Apps Section -->
      <div>
        <h2 class="text-2xl font-bold text-silk mb-8 pb-2 border-b border-gray-300">Apps</h2>

        <p class="text-default mb-8 leading-relaxed">
          พัฒนาองค์ความรู้ เพื่อสนับสนุนการเรียนการสอนและการวิจัยโดยใช้ผลและข้อมูลงานวิจัย สร้างเป็น web applications
          โดยใช้ R หรือ python + Shiny
        </p>

        <div class="grid grid-cols-1 gap-6">
          {
            apps.map((app) => (
              <a
                href={app.link}
                class="flex flex-col sm:flex-row items-center gap-6 p-4 rounded-xl hover:bg-velvet/50 transition-all group border border-transparent hover:border-champagne/20 shadow-sm hover:shadow-md bg-page"
              >
                <div class="w-full sm:w-48 h-32 flex-shrink-0 bg-velvet rounded-lg overflow-hidden border border-champagne/30 group-hover:border-champagne/60 transition-colors">
                  {app.image ? (
                    <img
                      src={app.image}
                      alt={app.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center bg-gradient-to-br from-velvet to-black">
                      <Icon
                        name={app.icon}
                        class="w-12 h-12 text-accent group-hover:scale-110 transition-transform duration-500"
                      />
                    </div>
                  )}
                </div>
                <div class="flex-1 min-w-0 text-center sm:text-left">
                  <h3 class="text-xl font-bold text-silk group-hover:text-accent transition-colors flex items-center justify-center sm:justify-start gap-2">
                    {app.title}
                    <Icon
                      name="tabler:external-link"
                      class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity"
                    />
                  </h3>
                  <p class="text-default mt-2 line-clamp-3 leading-relaxed">{app.description}</p>
                  <div class="mt-4 flex items-center justify-center sm:justify-start">
                    <span class="text-xs font-medium px-2.5 py-0.5 rounded bg-accent/10 text-accent border border-accent/20 group-hover:bg-accent group-hover:text-white transition-colors">
                      Open Application
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</PersonalLayout>
