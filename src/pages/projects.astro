  title: string;
  titleLink: string;
  description: string;
  image: string;
  imageAlt: string;
};

const writtenBooks: BookItem[] = [
  {
    title: "เทคนิคการทดลองในแปลงนาข้าว",
    titleLink: "https://kanthjs.github.io/tech_rice_exp_book/",
