---
import PersonalLayout from '~/layouts/PersonalLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';

const title = `Error 404`;
---

<PersonalLayout metadata={{ title }}>
  <section class="flex items-center min-h-screen p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h2 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h2>
        <p class="text-3xl font-semibold md:text-3xl text-white">ขออภัย ไม่พบหน้านี้</p>
        <p class="mt-4 mb-8 text-lg text-gray-300">
          แต่ไม่ต้องกังวล คุณสามารถกลับไปยังหน้าแรกได้ผ่าน BottomNav หรือคลิกปุ่มด้านล่าง
        </p>
        <a rel="noopener noreferrer" href={getHomePermalink()} class="btn ml-4">กลับไปหน้าแรก</a>
      </div>
    </div>
  </section>
</PersonalLayout>
