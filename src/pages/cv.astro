---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

// You can easily update your CV data here in the future
const cvData = {
  name: "กันต์",
  title: "Agricluteral scienctist",
  email: "[kanthanawit.j@rice.mail.go.th]",
  location: "Pathum Thani, Thailand",
  about: "นักวิชาการเกษตรโดยตำแหน่ง....",
  experience: [
    {
      role: "Researcher",
      company: "Agricultural Research Institute",
      period: "2016 - 2020",
      description: "พัฒนา R packages และระบบแจ้งเตือนโรคข้าว วิเคราะห์โมเดลทางสถิติและ Machine Learning นำเสนอข้อมูลในรูปแบบ Dashboard และ Web App"
    }
  ],
  education: [
    {
      degree: "Ph.D. in Plant Pathology",
      institution: "University of the Phlippine Los Baños",
      period: "2014 - 2018"
    },
  ],
  skills: [
    "R Programming", 
    "Machine Learning", "Statistical Modeling", 
    "App Development"
  ]
};
---

<Layout title="Kanth's Playbook | CV">
  <Header />

  <main class="max-w-3xl mx-auto px-6 py-16 md:py-24">
    <!-- Header Section -->
    <header class="mb-16 border-b border-gray-200 dark:border-gray-800 pb-12 flex flex-col md:flex-row justify-between items-center md:items-start gap-8">
      <div class="flex-1 text-center md:text-left">
        <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-gray-900 dark:text-gray-100 tracking-tight mb-4 font-bold">
          {cvData.name}
        </h1>
        <p class="text-xl text-gray-600 dark:text-gray-400 font-body-serif mb-6 leading-relaxed">
          {cvData.title}
        </p>
        
        <div class="flex flex-col sm:flex-row justify-center md:justify-start gap-2 sm:gap-6 text-sm text-gray-500 dark:text-gray-400 font-medium">
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {cvData.email}
          </span>
          <span class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {cvData.location}
          </span>
        </div>
      </div>

      <!-- Image Section -->
      <div class="w-48 h-48 md:w-64 md:h-64 lg:w-72 lg:h-72 shrink-0 rounded-[2rem] overflow-hidden bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-800 flex items-center justify-center relative shadow-sm">
        <!-- Placeholder text (Remove when image is added) -->
        <span class="text-gray-400 dark:text-gray-500 text-sm font-medium z-0">รูปภาพโปรไฟล์</span>
        
        <!-- คุณสามารถเอา Comment ออกเมื่อมีรูปพร้อมใช้งาน -->
        <img src="/images/me.jpg" alt={cvData.name} class="w-full h-full object-cover absolute inset-0 z-10" />
      </div>
    </header>

    <!-- Content Sections -->
    <div class="space-y-16">
      
      <!-- About -->
      <section>
        <h2 class="text-xs font-bold tracking-widest uppercase text-gray-400 dark:text-gray-500 mb-6">
          About
        </h2>
        <p class="text-gray-700 dark:text-gray-300 font-body-serif leading-relaxed">
          {cvData.about}
        </p>
      </section>

      <!-- Experience -->
      <section>
        <h2 class="text-xs font-bold tracking-widest uppercase text-gray-400 dark:text-gray-500 mb-8">
          Experience
        </h2>
        <div class="space-y-10">
          {cvData.experience.map((job) => (
            <div class="relative pl-8 md:pl-0">
              <!-- Timeline line (mobile only) -->
              <div class="absolute left-0 top-2 bottom-0 w-px bg-gray-200 dark:bg-gray-800 md:hidden"></div>
              <div class="absolute left-[-4px] top-2 w-2 h-2 rounded-full bg-gray-400 dark:bg-gray-600 md:hidden"></div>
              
              <div class="flex flex-col md:flex-row md:gap-8">
                <div class="md:w-1/4 shrink-0 mb-2 md:mb-0">
                  <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                    {job.period}
                  </p>
                </div>
                <div class="md:w-3/4">
                  <h3 class="text-lg font-serif text-gray-900 dark:text-gray-100 mb-1">
                    {job.role}
                  </h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
                    {job.company}
                  </p>
                  <p class="text-gray-600 dark:text-gray-400 font-body-serif leading-relaxed text-sm">
                    {job.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2 class="text-xs font-bold tracking-widest uppercase text-gray-400 dark:text-gray-500 mb-8">
          Education
        </h2>
        <div class="space-y-8">
          {cvData.education.map((edu) => (
            <div class="flex flex-col md:flex-row md:gap-8">
              <div class="md:w-1/4 shrink-0 mb-1 md:mb-0">
                <p class="text-sm text-gray-500 dark:text-gray-400 font-medium">
                  {edu.period}
                </p>
              </div>
              <div class="md:w-3/4">
                <h3 class="text-base font-serif text-gray-900 dark:text-gray-100">
                  {edu.degree}
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                  {edu.institution}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section>
        <h2 class="text-xs font-bold tracking-widest uppercase text-gray-400 dark:text-gray-500 mb-6">
          Skills
        </h2>
        <div class="flex flex-wrap gap-2">
          {cvData.skills.map((skill) => (
            <span class="px-3 py-1 bg-gray-100 dark:bg-gray-800/50 text-gray-700 dark:text-gray-300 rounded-lg text-sm font-medium border border-gray-200 dark:border-gray-800">
              {skill}
            </span>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>
